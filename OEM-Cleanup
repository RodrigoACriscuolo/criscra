Script - OEM Clean-up
-----------------
Target remove no essential application of Windows OS
-----------------
#Requires -RunAsAdministrator

$ErrorActionPreference = "Stop"

$OemPatterns = @(
    "*Dell*", "*HP*", "*HPInc*", "*HewlettPackard*", "*Acer*",
    "*Asus*", "*Toshiba*", "*Samsung*", "*McAfee*", "*Lenovo*",
    "*Symantec*", "*Norton*", "*TrendMicro*", "*Avast*", "*WildTangent*",
    "*BitDefender*", "*Kaspersky*", "*ESET*"
)

$SafeExclusions = @(
    "*Driver*", "*Chipset*", "*Audio*", "*Graphics*", "*WLAN*",
    "*Bluetooth*", "*Intel*", "*NVIDIA*", "*AMD*", "*Realtek*",
    "*Synaptics*", "*Touchpad*", "*DisplayLink*", "*System Interface*",
    "*Runtime*", "*Redistributable*", "*Microsoft*"
)

function Test-PatternMatch {
    param(
        [AllowEmptyString()]
        [string]$Name,

        [string[]]$Patterns
    )

    if ([string]::IsNullOrWhiteSpace($Name)) {
        return $false
    }

    foreach ($Pattern in $Patterns) {
        if ($Name -like $Pattern) {
            return $true
        }
    }

    return $false
}

function Invoke-RegistryUninstaller {
    param(
        [Parameter(Mandatory)]
        [string]$DisplayName,

        [string]$UninstallString,

        [string]$QuietUninstallString
    )

    $UninstallCommand = if ($QuietUninstallString) {
        $QuietUninstallString
    } else {
        $UninstallString
    }

    if ([string]::IsNullOrWhiteSpace($UninstallCommand)) {
        Write-Warning "No uninstall command found for: $DisplayName"
        return
    }

    Write-Host "Uninstalling: $DisplayName"

    # MSI package identified by a GUID.
    if ($UninstallCommand -match '\{[0-9A-Fa-f-]{36}\}') {
        Start-Process `
            -FilePath "$env:SystemRoot\System32\msiexec.exe" `
            -ArgumentList "/X `"$($Matches[0])`" /qn /norestart" `
            -Wait `
            -NoNewWindow
        return
    }

    # Parse a quoted executable path or a path ending in .exe/.com.
    $ExePath = $null
    $ExistingArguments = $null

    if ($UninstallCommand -match '^"(?<path>[^"]+)"\s*(?<args>.*)$') {
        $ExePath = $Matches['path']
        $ExistingArguments = $Matches['args'].Trim()
    }
    elseif ($UninstallCommand -match '^(?<path>[A-Za-z]:\\.+?\.(?:exe|com))(?<args>\s.*)?$') {
        $ExePath = $Matches['path'].Trim()
        $ExistingArguments = $Matches['args'].Trim()
    }

    if ($ExePath -and (Test-Path -LiteralPath $ExePath)) {
        $SilentArguments = $ExistingArguments
        if ([string]::IsNullOrWhiteSpace($SilentArguments)) {
            $SilentArguments = "/S"
        }
        elseif ($SilentArguments -notmatch '(^|\s)(/S|/silent|/quiet)(\s|$)') {
            $SilentArguments += " /S"
        }

        Start-Process `
            -FilePath $ExePath `
            -ArgumentList $SilentArguments `
            -Wait `
            -NoNewWindow
    }
    else {
        Write-Warning "Uninstaller path not found or could not be parsed: $DisplayName"
    }
}

# 1. Remove provisioned AppX packages.
try {
    $Provisioned = Get-AppxProvisionedPackage -Online -ErrorAction Stop |
        Where-Object {
            Test-PatternMatch -Name $_.DisplayName -Patterns $OemPatterns
        }

    foreach ($Package in $Provisioned) {
        try {
            Write-Host "Removing provisioned package: $($Package.DisplayName)"
            Remove-AppxProvisionedPackage `
                -Online `
                -PackageName $Package.PackageName `
                -ErrorAction Stop
        }
        catch {
            Write-Warning "Provisioned package removal failed: $($Package.DisplayName): $($_.Exception.Message)"
        }
    }
}
catch {
    Write-Warning "Could not retrieve provisioned AppX packages: $($_.Exception.Message)"
}

# 2. Remove installed AppX packages for all users.
try {
    $InstalledAppx = Get-AppxPackage -AllUsers -ErrorAction Stop |
        Where-Object {
            Test-PatternMatch -Name $_.Name -Patterns $OemPatterns
        }

    foreach ($Package in $InstalledAppx) {
        try {
            Write-Host "Removing installed package: $($Package.Name)"
            Remove-AppxPackage `
                -Package $Package.PackageFullName `
                -AllUsers `
                -ErrorAction Stop
        }
        catch {
            Write-Warning "AppX package removal failed: $($Package.Name): $($_.Exception.Message)"
        }
    }
}
catch {
    Write-Warning "Could not retrieve installed AppX packages: $($_.Exception.Message)"
}

# 3. Remove matching Win32 applications.
$UninstallPaths = @(
    "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*",
    "HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*"
)

$InstalledApps = foreach ($Path in $UninstallPaths) {
    if (Test-Path $Path) {
        Get-ItemProperty -Path $Path -ErrorAction SilentlyContinue
    }
}

foreach ($App in $InstalledApps) {
    if ([string]::IsNullOrWhiteSpace($App.DisplayName)) {
        continue
    }

    $MatchesOem = Test-PatternMatch `
        -Name $App.DisplayName `
        -Patterns $OemPatterns

    $MatchesExclusion = Test-PatternMatch `
        -Name $App.DisplayName `
        -Patterns $SafeExclusions

    if (-not $MatchesOem -or $MatchesExclusion) {
        continue
    }

    Invoke-RegistryUninstaller `
        -DisplayName $App.DisplayName `
        -UninstallString ([string]$App.UninstallString) `
        -QuietUninstallString ([string]$App.QuietUninstallString)
}
