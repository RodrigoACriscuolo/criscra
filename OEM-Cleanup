#Requires -Version 5.1
#Requires -RunAsAdministrator

<#
.SYNOPSIS
    Review an exact allowlist of optional Windows AppX packages and remove only
    explicitly selected package names and installation scopes.

.DESCRIPTION
    The action menu appears before any inventory scan. Inventory is read-only.
    Installed packages are grouped by exact package Name and shown separately
    from provisioned packages. Removal is by individual IDs or one category and
    one scope at a time. There is intentionally no remove-everything action.

    This allowlist is a conservative starting point, not a claim that listed
    apps are unnecessary to every user. Xbox support/identity components are
    deliberately excluded. Win32/OEM applications are not removed.

    Test in a disposable VM. This script cannot reboot or verify post-reboot
    behavior automatically.
#>

$ErrorActionPreference = 'Stop'

# Exact package family names only. New or similarly named packages are not
# candidates unless deliberately reviewed and added here.
$CandidateCategories = [ordered]@{
    'Consumer and media' = @(
        'Microsoft.BingNews', 'Microsoft.BingWeather', 'Microsoft.GetHelp',
        'Microsoft.Getstarted', 'Microsoft.MicrosoftOfficeHub',
        'Microsoft.MicrosoftSolitaireCollection', 'Microsoft.People',
        'Microsoft.SkypeApp', 'Microsoft.Todos', 'Microsoft.WindowsAlarms',
        'Microsoft.WindowsCamera', 'Microsoft.WindowsFeedbackHub',
        'Microsoft.WindowsMaps', 'Microsoft.WindowsSoundRecorder',
        'Microsoft.ZuneMusic', 'Microsoft.ZuneVideo', 'Clipchamp.Clipchamp',
        'Microsoft.MixedReality.Portal', 'Microsoft.Microsoft3DViewer',
        'Microsoft.MicrosoftStickyNotes', 'Microsoft.Office.OneNote'
    )
    'Xbox and gaming' = @(
        'Microsoft.GamingApp', 'Microsoft.XboxApp',
        'Microsoft.XboxGameOverlay', 'Microsoft.XboxGamingOverlay'
    )
    'Communication and support' = @(
        'Microsoft.YourPhone', 'MicrosoftWindows.CrossDevice', 'MSTeams',
        'MicrosoftTeams', 'MicrosoftCorporationII.QuickAssist',
        'Microsoft.PowerAutomateDesktop'
    )
}

# Explicit denylist wins even if a name is accidentally added to a candidate
# category later. Includes platform/security/store/framework and Xbox support
# components that may be dependencies for apps or games.
$DeniedPackageNames = @(
    'Microsoft.WindowsStore', 'Microsoft.StorePurchaseApp',
    'Microsoft.DesktopAppInstaller', 'Microsoft.WindowsAppRuntime',
    'Microsoft.VCLibs', 'Microsoft.NET.Native.Framework',
    'Microsoft.NET.Native.Runtime', 'Microsoft.Windows.ShellExperienceHost',
    'Microsoft.Windows.StartMenuExperienceHost', 'Microsoft.AAD.BrokerPlugin',
    'Microsoft.LockApp', 'Microsoft.Windows.CloudExperienceHost',
    'Microsoft.Windows.ContentDeliveryManager', 'Microsoft.SecHealthUI',
    'MicrosoftWindows.Client.WebExperience', 'MicrosoftWindows.Client.CBS',
    'Microsoft.WindowsNotepad', 'Microsoft.WindowsTerminal',
    'Microsoft.Xbox.TCUI', 'Microsoft.XboxGameCallableUI',
    'Microsoft.XboxIdentityProvider', 'Microsoft.XboxSpeechToTextOverlay'
)

function Test-RequiredCommands {
    foreach ($commandName in @(
        'Get-AppxPackage', 'Get-AppxProvisionedPackage',
        'Remove-AppxPackage', 'Remove-AppxProvisionedPackage'
    )) {
        if (-not (Get-Command $commandName -ErrorAction SilentlyContinue)) {
            throw "Required command '$commandName' was not found. Run this in Windows PowerShell 5.1 on Windows with Appx/DISM cmdlets available."
        }
    }
}

function Get-CandidateCategory {
    param([string] $Name)
    if ([string]::IsNullOrWhiteSpace($Name) -or $Name -in $DeniedPackageNames) { return $null }
    foreach ($category in $CandidateCategories.Keys) {
        if ($Name -in $CandidateCategories[$category]) { return $category }
    }
    return $null
}

function Get-CandidateInventory {
    Test-RequiredCommands
    $groups = @{}
    $inventoryErrors = New-Object System.Collections.Generic.List[string]

    try {
        foreach ($package in (Get-AppxPackage -AllUsers -ErrorAction Stop)) {
            $name = [string]$package.Name
            $category = Get-CandidateCategory -Name $name
            if (-not $category) { continue }
            $scope = 'Installed (all users)'
            $key = "$scope|$name"
            if (-not $groups.ContainsKey($key)) {
                $groups[$key] = [pscustomobject]@{
                    Id = 0; Scope = $scope; Category = $category; Name = $name
                    PackageIds = New-Object System.Collections.Generic.List[string]
                    Kind = 'Installed'
                }
            }
            $packageId = [string]$package.PackageFullName
            if (-not $groups[$key].PackageIds.Contains($packageId)) {
                $groups[$key].PackageIds.Add($packageId)
            }
        }
    }
    catch { $inventoryErrors.Add("Installed packages: $($_.Exception.Message)") }

    try {
        foreach ($package in (Get-AppxProvisionedPackage -Online -ErrorAction Stop)) {
            $name = [string]$package.DisplayName
            $category = Get-CandidateCategory -Name $name
            if (-not $category) { continue }
            $scope = 'Provisioned (future profiles)'
            $key = "$scope|$name"
            if (-not $groups.ContainsKey($key)) {
                $groups[$key] = [pscustomobject]@{
                    Id = 0; Scope = $scope; Category = $category; Name = $name
                    PackageIds = New-Object System.Collections.Generic.List[string]
                    Kind = 'Provisioned'
                }
            }
            $packageId = [string]$package.PackageName
            if (-not $groups[$key].PackageIds.Contains($packageId)) {
                $groups[$key].PackageIds.Add($packageId)
            }
        }
    }
    catch { $inventoryErrors.Add("Provisioned packages: $($_.Exception.Message)") }

    $sorted = @($groups.Values | Sort-Object Scope, Category, Name)
    $id = 0
    foreach ($item in $sorted) { $id++; $item.Id = $id }

    # Return one inventory object only; no formatting output is mixed into it.
    return [pscustomobject]@{ Items = $sorted; Errors = @($inventoryErrors) }
}

function Show-Inventory {
    param([object[]] $Items, [string[]] $Errors = @())
    if ($Errors.Count) {
        Write-Warning 'Inventory may be incomplete:'
        foreach ($message in $Errors) { Write-Warning "  $message" }
    }

    foreach ($scope in @('Installed (all users)', 'Provisioned (future profiles)')) {
        Write-Host "`n$scope" -ForegroundColor Cyan
        $scopeItems = @($Items | Where-Object { $_.Scope -eq $scope })
        if ($scopeItems.Count -eq 0) {
            Write-Host '  No allowlisted packages found.'
            continue
        }
        # Out-Host is important: prevents Format-Table output from being
        # captured into $inventory when this function is called from a menu.
        $scopeItems |
            Select-Object Id, Category, Name,
                @{Name='PackageVersions';Expression={$_.PackageIds.Count}} |
            Format-Table -Wrap -AutoSize |
            Out-Host
    }
    Write-Host "`nCandidate names are exact allowlist matches only. Versions of each Name are grouped together."
}

function Confirm-AndRemove {
    param([object[]] $Selected)
    if (-not $Selected -or $Selected.Count -eq 0) {
        Write-Host 'No matching entries; nothing to remove.'
        return
    }

    Write-Host "`nExact selection (each package identity is shown):" -ForegroundColor Yellow
    foreach ($item in $Selected) {
        Write-Host "ID $($item.Id) | $($item.Scope) | $($item.Category) | $($item.Name)"
        foreach ($packageId in $item.PackageIds) { Write-Host "    $packageId" }
    }
    Write-Host 'Installed removal uses -AllUsers. Provisioned removal affects future profiles.' -ForegroundColor Yellow
    $phrase = Read-Host 'Type YES to authorize exactly the entries shown (anything else cancels)'
    if ($phrase -cne 'YES') {
        Write-Host 'Cancelled; nothing was removed.'
        return
    }

    foreach ($item in $Selected) {
        foreach ($packageId in $item.PackageIds) {
            try {
                if ($item.Kind -eq 'Installed') {
                    Remove-AppxPackage -Package $packageId -AllUsers -ErrorAction Stop | Out-Null
                }
                elseif ($item.Kind -eq 'Provisioned') {
                    Remove-AppxProvisionedPackage -Online -PackageName $packageId -ErrorAction Stop | Out-Null
                }
                else {
                    throw "Unknown removal scope '$($item.Kind)'."
                }
                Write-Host "Removal command completed: $packageId" -ForegroundColor Green
            }
            catch {
                Write-Warning "Removal failed for '$packageId': $($_.Exception.Message)"
            }
        }
    }
}

function Get-CurrentInventory {
    $result = Get-CandidateInventory
    Show-Inventory -Items $result.Items -Errors $result.Errors
    # Show-Inventory writes only to the host. This function returns exactly
    # the inventory object for assignments in the menu.
    return $result
}

Write-Host 'Windows Optional App Review and Cleanup' -ForegroundColor Cyan
Write-Host 'No inventory scan or removal starts until you choose an action.'
Write-Host 'There is no remove-everything action. Select individual names or one category and scope.'
Write-Host 'Xbox support/identity packages are excluded from the removal candidates.'

$inventory = $null
while ($true) {
    Write-Host "`nActions: L=list, S=select IDs for removal, C=remove one category, R=refresh, Q=quit"
    $choice = (Read-Host 'Choice').Trim().ToUpperInvariant()
    switch ($choice) {
        'L' { $inventory = Get-CurrentInventory }
        'R' { $inventory = Get-CurrentInventory }
        'S' {
            if ($null -eq $inventory) { $inventory = Get-CurrentInventory }
            if ($inventory.Items.Count -eq 0) { Write-Host 'No candidates available.'; break }
            $raw = Read-Host 'Enter ID(s) from the current inventory, comma-separated'
            if ([string]::IsNullOrWhiteSpace($raw)) { Write-Host 'Cancelled.'; break }
            $ids = @()
            $valid = $true
            foreach ($part in ($raw -split ',')) {
                $number = 0
                if (-not [int]::TryParse($part.Trim(), [ref]$number)) { $valid = $false; break }
                $ids += $number
            }
            $uniqueIds = @($ids | Sort-Object -Unique)
            $selected = @($inventory.Items | Where-Object { $_.Id -in $uniqueIds } | Sort-Object Id)
            if (-not $valid -or $selected.Count -ne $uniqueIds.Count) {
                Write-Warning 'Invalid or stale ID; nothing was removed.'
                break
            }
            Confirm-AndRemove -Selected $selected
            $inventory = $null
        }
        'C' {
            if ($null -eq $inventory) { $inventory = Get-CurrentInventory }
            $categories = @($CandidateCategories.Keys)
            for ($i = 0; $i -lt $categories.Count; $i++) {
                Write-Host "  $($i + 1) - $($categories[$i])"
            }
            $categoryNumber = 0
            if (-not [int]::TryParse((Read-Host 'Choose one category number'), [ref]$categoryNumber) -or
                $categoryNumber -lt 1 -or $categoryNumber -gt $categories.Count) {
                Write-Host 'Invalid category; nothing was removed.'
                break
            }
            $category = $categories[$categoryNumber - 1]
            Write-Host "  1 - Installed (all users)`n  2 - Provisioned (future profiles)"
            $scopeChoice = Read-Host 'Choose one scope number'
            $scope = if ($scopeChoice -eq '1') {
                'Installed (all users)'
            } elseif ($scopeChoice -eq '2') {
                'Provisioned (future profiles)'
            } else {
                $null
            }
            if (-not $scope) { Write-Host 'Invalid scope; nothing was removed.'; break }
            $selected = @($inventory.Items | Where-Object {
                $_.Category -eq $category -and $_.Scope -eq $scope
            })
            if ($selected.Count -eq 0) {
                Write-Host 'No entries in that category and scope.'
                break
            }
            Confirm-AndRemove -Selected $selected
            $inventory = $null
        }
        'Q' { break }
        default { Write-Host 'Choose L, S, C, R, or Q.' }
    }
    if ($choice -eq 'Q') { break }
}
Write-Host 'Finished.'
