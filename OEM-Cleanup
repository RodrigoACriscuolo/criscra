#Requires -Version 5.1
#Requires -RunAsAdministrator

<#
.SYNOPSIS
    Reviews likely optional Windows and OEM applications and removes only packages
    explicitly selected by the administrator.

.DESCRIPTION
    This is a conservative first-pass cleanup tool. It inventories current-user
    AppX packages and Windows provisioned AppX packages. Candidate matching is a
    suggestion, not a guarantee that an application is unnecessary.

    AppX packages can be selected individually or all suggested AppX candidates
    can be selected for removal after an explicit confirmation. Provisioned
    package removal affects future user profiles. Win32 applications are listed
    for review only; this script does not invoke their uninstall commands because
    vendor uninstallers and silent switches are not reliably interchangeable.

    Nothing is removed on startup. The operator must choose an action and confirm.
#>

$ErrorActionPreference = 'Stop'

$OptionalMicrosoftPatterns = @(
    'Microsoft.BingNews',
    'Microsoft.BingWeather',
    'Microsoft.GetHelp',
    'Microsoft.Getstarted',
    'Microsoft.MicrosoftOfficeHub',
    'Microsoft.MicrosoftSolitaireCollection',
    'Microsoft.People',
    'Microsoft.SkypeApp',
    'Microsoft.Todos',
    'Microsoft.WindowsAlarms',
    'Microsoft.WindowsCamera',
    'Microsoft.WindowsFeedbackHub',
    'Microsoft.WindowsMaps',
    'Microsoft.WindowsSoundRecorder',
    'Microsoft.Xbox*',
    'Microsoft.GamingApp',
    'Microsoft.ZuneMusic',
    'Microsoft.ZuneVideo',
    'Microsoft.YourPhone',
    'MicrosoftTeams',
    'MSTeams',
    'Clipchamp.Clipchamp',
    'MicrosoftCorporationII.QuickAssist',
    'MicrosoftWindows.CrossDevice'
)

$OemPatterns = @(
    '*Dell*', '*HP*', '*HPInc*', '*HewlettPackard*', '*Acer*', '*Asus*',
    '*Toshiba*', '*Samsung*', '*Lenovo*', '*McAfee*', '*Symantec*',
    '*Norton*', '*TrendMicro*', '*Avast*', '*WildTangent*', '*BitDefender*',
    '*Kaspersky*', '*ESET*'
)

$ProtectedPatterns = @(
    '*Driver*', '*Chipset*', '*Audio*', '*Graphics*', '*WLAN*', '*Bluetooth*',
    '*Intel*', '*NVIDIA*', '*AMD*', '*Realtek*', '*Synaptics*', '*Touchpad*',
    '*DisplayLink*', '*SystemInterface*', '*Runtime*', '*Redistributable*',
    '*Framework*', '*VCLibs*', '*NET.Native*', '*WindowsStore*',
    '*DesktopAppInstaller*', '*Windows.ShellExperienceHost*',
    '*Windows.StartMenuExperienceHost*', '*SecHealthUI*', '*AAD.BrokerPlugin*',
    '*Windows.CloudExperienceHost*', '*Windows.ContentDeliveryManager*'
)

function Test-AnyPattern {
    param(
        [AllowEmptyString()]
        [string] $Text,
        [string[]] $Patterns
    )

    if ([string]::IsNullOrWhiteSpace($Text)) { return $false }
    foreach ($pattern in $Patterns) {
        if ($Text -like $pattern) { return $true }
    }
    return $false
}

function Test-IsAppCandidate {
    param([string] $Identity)

    if ([string]::IsNullOrWhiteSpace($Identity)) { return $false }
    if (Test-AnyPattern -Text $Identity -Patterns $ProtectedPatterns) { return $false }

    return (Test-AnyPattern -Text $Identity -Patterns $OptionalMicrosoftPatterns) -or
           (Test-AnyPattern -Text $Identity -Patterns $OemPatterns)
}

function Get-CandidateInventory {
    $items = New-Object System.Collections.Generic.List[object]
    $id = 0

    Write-Host 'Scanning current-user AppX packages and provisioned packages...' -ForegroundColor Cyan

    try {
        foreach ($package in (Get-AppxPackage -ErrorAction Stop)) {
            $identity = [string]$package.Name
            if (-not (Test-IsAppCandidate -Identity $identity)) { continue }
            $id++
            $items.Add([pscustomobject]@{
                Id = $id
                Type = 'AppX - current user'
                Name = $identity
                PackageId = [string]$package.PackageFullName
                Object = $package
                Removable = $true
            })
        }
    }
    catch {
        Write-Warning "Could not enumerate current-user AppX packages: $($_.Exception.Message)"
    }

    try {
        foreach ($package in (Get-AppxProvisionedPackage -Online -ErrorAction Stop)) {
            $identity = [string]$package.DisplayName
            $packageName = [string]$package.PackageName
            if (-not ((Test-IsAppCandidate -Identity $identity) -or
                      (Test-IsAppCandidate -Identity $packageName))) { continue }
            $id++
            $items.Add([pscustomobject]@{
                Id = $id
                Type = 'AppX - future profiles'
                Name = $(if ($identity) { $identity } else { $packageName })
                PackageId = $packageName
                Object = $package
                Removable = $true
            })
        }
    }
    catch {
        Write-Warning "Could not enumerate provisioned AppX packages: $($_.Exception.Message)"
    }

    return ,$items
}

function Show-Candidates {
    param([object[]] $Items)

    if (-not $Items -or $Items.Count -eq 0) {
        Write-Host 'No suggested optional AppX packages were found.' -ForegroundColor Green
        return
    }

    Write-Host "`nSuggested optional AppX packages (review each item):" -ForegroundColor Yellow
    $Items | Select-Object Id, Type, Name, PackageId | Format-Table -Wrap -AutoSize
    Write-Host 'Current-user removal affects the current signed-in user only.'
    Write-Host 'Future-profile removal removes the package from the online Windows image.'
}

function Remove-Candidate {
    param([Parameter(Mandatory)] [object] $Item)

    if ($Item.Type -eq 'AppX - current user') {
        Remove-AppxPackage -Package $Item.PackageId -ErrorAction Stop
    }
    elseif ($Item.Type -eq 'AppX - future profiles') {
        Remove-AppxProvisionedPackage -Online -PackageName $Item.PackageId -ErrorAction Stop | Out-Null
    }
    else {
        throw "Unsupported package type: $($Item.Type)"
    }
}

function Get-ReviewOnlyWin32Apps {
    $paths = @(
        'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*',
        'HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*',
        'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*'
    )
    $found = @{}

    foreach ($path in $paths) {
        if (-not (Test-Path -LiteralPath $path)) { continue }
        foreach ($app in (Get-ItemProperty -Path $path -ErrorAction SilentlyContinue)) {
            $name = [string]$app.DisplayName
            if ([string]::IsNullOrWhiteSpace($name)) { continue }
            if (-not (Test-AnyPattern -Text $name -Patterns $OemPatterns)) { continue }
            if (Test-AnyPattern -Text $name -Patterns $ProtectedPatterns) { continue }
            $key = "$name|$($app.Publisher)"
            if (-not $found.ContainsKey($key)) {
                $found[$key] = [pscustomobject]@{ Name = $name; Publisher = [string]$app.Publisher }
            }
        }
    }
    return @($found.Values | Sort-Object Name)
}

function Show-Win32ReviewList {
    $apps = @(Get-ReviewOnlyWin32Apps)
    if ($apps.Count -eq 0) {
        Write-Host "`nNo likely OEM Win32 applications found in the checked uninstall registry entries."
        return
    }
    Write-Host "`nLikely OEM desktop applications (review-only; not removed by this script):" -ForegroundColor Yellow
    $apps | Format-Table Name, Publisher -Wrap -AutoSize
    Write-Host 'Remove these individually through Windows Settings > Apps after reviewing them.'
}

function Invoke-RemovalSelection {
    param([object[]] $Items, [switch] $All)

    if (-not $Items -or $Items.Count -eq 0) {
        Write-Host 'There are no removable AppX candidates.'
        return
    }

    $selected = @()
    if ($All) {
        $selected = @($Items)
        Write-Host "`nYou chose ALL $($selected.Count) suggested AppX package entries." -ForegroundColor Yellow
        Write-Host 'This can remove Microsoft consumer apps and OEM apps that you may rely on.' -ForegroundColor Yellow
        $confirmation = Read-Host 'Type REMOVE ALL to authorize removal of every listed entry'
        if ($confirmation -cne 'REMOVE ALL') {
            Write-Host 'No packages were removed.'
            return
        }
    }
    else {
        $rawIds = Read-Host 'Enter the ID(s) to remove, separated by commas (or press Enter to cancel)'
        if ([string]::IsNullOrWhiteSpace($rawIds)) {
            Write-Host 'Cancelled. No packages were removed.'
            return
        }
        $requestedIds = @()
        foreach ($part in ($rawIds -split ',')) {
            $number = 0
            if (-not [int]::TryParse($part.Trim(), [ref]$number)) {
                Write-Warning "Invalid ID '$($part.Trim())'. Nothing was removed."
                return
            }
            $requestedIds += $number
        }
        $selected = @($Items | Where-Object { $_.Id -in $requestedIds } | Sort-Object Id -Unique)
        if ($selected.Count -ne (@($requestedIds | Sort-Object -Unique).Count)) {
            Write-Warning 'One or more IDs were not in the current list. Nothing was removed.'
            return
        }
        Write-Host "`nSelected packages:" -ForegroundColor Yellow
        $selected | Select-Object Id, Type, Name, PackageId | Format-Table -Wrap -AutoSize
        $confirmation = Read-Host 'Type YES to authorize removal of only these listed entries'
        if ($confirmation -cne 'YES') {
            Write-Host 'Cancelled. No packages were removed.'
            return
        }
    }

    foreach ($item in $selected) {
        try {
            Write-Host "Removing $($item.Name) ($($item.Type))..."
            Remove-Candidate -Item $item
            Write-Host 'Removal command completed.' -ForegroundColor Green
        }
        catch {
            Write-Warning "Removal failed for '$($item.Name)': $($_.Exception.Message)"
        }
    }
}

Write-Host 'Windows Optional App Review and Cleanup' -ForegroundColor Cyan
Write-Host 'Candidates are suggestions only; this script cannot determine your personal needs.'
Write-Host 'No package is removed unless you explicitly select an action and confirm it.'

$items = @(Get-CandidateInventory)
Show-Candidates -Items $items
Show-Win32ReviewList

while ($true) {
    Write-Host "`nChoose an action:"
    Write-Host '  L - List suggested AppX packages again'
    Write-Host '  S - Select AppX package(s) for removal by ID'
    Write-Host '  A - Remove all suggested AppX package entries (requires typing REMOVE ALL)'
    Write-Host '  R - Refresh inventory'
    Write-Host '  Q - Quit'
    $choice = (Read-Host 'Choice').Trim().ToUpperInvariant()

    switch ($choice) {
        'L' { Show-Candidates -Items $items; Show-Win32ReviewList }
        'S' { Invoke-RemovalSelection -Items $items }
        'A' { Invoke-RemovalSelection -Items $items -All }
        'R' {
            $items = @(Get-CandidateInventory)
            Show-Candidates -Items $items
            Show-Win32ReviewList
        }
        'Q' { break }
        default { Write-Host 'Please choose L, S, A, R, or Q.' }
    }
    if ($choice -eq 'Q') { break }
}

Write-Host 'Finished. No additional actions will be taken.'
