#Requires -Version 5.1
#Requires -RunAsAdministrator

<#
.SYNOPSIS
    Inventory and explicitly authorized removal of selected optional Windows AppX packages.

.DESCRIPTION
    Lists AppX packages installed for any user and packages provisioned for future
    user profiles. Curated names are flagged as suggested optional apps; matching
    is only a starting point, not a determination that an app is unnecessary.

    No removals happen automatically. Individual selected entries require typing
    YES after reviewing the names. Removing all candidates requires typing the
    exact phrase REMOVE ALL. Win32 desktop apps are inventory-only in this version.

    Save as OEM-CleanUp.ps1 and run in elevated Windows PowerShell 5.1.
#>

$ErrorActionPreference = 'Stop'

# Deliberately use known package identities rather than broad words such as
# '*Camera*', '*News*', or '*Paint*', which can match unrelated components.
$OptionalMicrosoftPatterns = @(
    'Microsoft.BingNews',
    'Microsoft.BingWeather',
    'Microsoft.GetHelp',
    'Microsoft.Getstarted',
    'Microsoft.MicrosoftOfficeHub',
    'Microsoft.MicrosoftSolitaireCollection',
    'Microsoft.People',
    'Microsoft.SkypeApp',
    'Microsoft.Todos',
    'Microsoft.WindowsAlarms',
    'Microsoft.WindowsCamera',
    'Microsoft.WindowsFeedbackHub',
    'Microsoft.WindowsMaps',
    'Microsoft.WindowsSoundRecorder',
    'Microsoft.Xbox*',
    'Microsoft.GamingApp',
    'Microsoft.ZuneMusic',
    'Microsoft.ZuneVideo',
    'Microsoft.YourPhone',
    'MicrosoftTeams*',
    'MSTeams*',
    'Clipchamp.Clipchamp',
    'MicrosoftCorporationII.QuickAssist',
    'MicrosoftWindows.CrossDevice',
    'Microsoft.PowerAutomateDesktop',
    'Microsoft.MixedReality.Portal',
    'Microsoft.Microsoft3DViewer',
    'Microsoft.MicrosoftStickyNotes',
    'Microsoft.Office.OneNote'
)

# OEM/security trial apps are candidates for review only. A vendor match does
# not mean the program is unneeded; do not select an item unless you recognize it.
$OemPatterns = @(
    '*Dell*', '*HP*', '*HPInc*', '*HewlettPackard*', '*Acer*', '*Asus*',
    '*Toshiba*', '*Samsung*', '*Lenovo*', '*McAfee*', '*Symantec*',
    '*Norton*', '*TrendMicro*', '*Avast*', '*WildTangent*', '*BitDefender*',
    '*Kaspersky*', '*ESET*'
)

# Never flag likely platform components/frameworks for AppX removal.
$ProtectedPatterns = @(
    '*WindowsStore*', '*DesktopAppInstaller*', '*AppInstaller*',
    '*ShellExperienceHost*', '*StartMenuExperienceHost*', '*SecHealthUI*',
    '*AAD.BrokerPlugin*', '*LockApp*', '*ContentDeliveryManager*',
    '*CloudExperienceHost*', '*CBSPreview*', '*NET.Native*', '*VCLibs*',
    '*Runtime*', '*Framework*', '*WindowsDefender*', '*WindowsTerminal*'
)

function Test-AnyPattern {
    param([AllowEmptyString()][string] $Text, [string[]] $Patterns)
    if ([string]::IsNullOrWhiteSpace($Text)) { return $false }
    foreach ($pattern in $Patterns) {
        if ($Text -like $pattern) { return $true }
    }
    return $false
}

function Test-OptionalCandidate {
    param([AllowEmptyString()][string] $Identity)
    if ([string]::IsNullOrWhiteSpace($Identity)) { return $false }
    if (Test-AnyPattern -Text $Identity -Patterns $ProtectedPatterns) { return $false }
    return (Test-AnyPattern -Text $Identity -Patterns $OptionalMicrosoftPatterns) -or
           (Test-AnyPattern -Text $Identity -Patterns $OemPatterns)
}

function Get-CandidateInventory {
    $items = New-Object System.Collections.Generic.List[object]
    $seen = @{}
    $id = 0

    Write-Host 'Checking PowerShell commands and reading AppX inventories...' -ForegroundColor Cyan
    foreach ($commandName in @('Get-AppxPackage', 'Get-AppxProvisionedPackage', 'Remove-AppxPackage', 'Remove-AppxProvisionedPackage')) {
        if (-not (Get-Command $commandName -ErrorAction SilentlyContinue)) {
            throw "Required Windows command '$commandName' was not found. Use Windows PowerShell on Windows with the Appx/DISM components available."
        }
    }

    try {
        foreach ($package in (Get-AppxPackage -AllUsers -ErrorAction Stop)) {
            $identity = [string]$package.Name
            if (-not (Test-OptionalCandidate -Identity $identity)) { continue }
            $key = 'Installed|' + [string]$package.PackageFullName
            if ($seen.ContainsKey($key)) { continue }
            $seen[$key] = $true
            $id++
            $items.Add([pscustomobject]@{
                Id = $id
                Scope = 'Installed (all users)'
                Name = $identity
                PackageId = [string]$package.PackageFullName
                Kind = 'Installed'
            })
        }
    }
    catch {
        Write-Warning "Could not enumerate AppX packages for all users: $($_.Exception.Message)"
    }

    try {
        foreach ($package in (Get-AppxProvisionedPackage -Online -ErrorAction Stop)) {
            $identity = [string]$package.DisplayName
            $packageName = [string]$package.PackageName
            if (-not ((Test-OptionalCandidate -Identity $identity) -or
                      (Test-OptionalCandidate -Identity $packageName))) { continue }
            $key = 'Provisioned|' + $packageName
            if ($seen.ContainsKey($key)) { continue }
            $seen[$key] = $true
            $id++
            $items.Add([pscustomobject]@{
                Id = $id
                Scope = 'Provisioned (future profiles)'
                Name = $(if ($identity) { $identity } else { $packageName })
                PackageId = $packageName
                Kind = 'Provisioned'
            })
        }
    }
    catch {
        Write-Warning "Could not enumerate provisioned AppX packages: $($_.Exception.Message)"
    }

    # Return individual rows, not a nested collection (which caused blank tables).
    return $items.ToArray()
}

function Get-Win32ReviewInventory {
    $paths = @(
        'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*',
        'HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*',
        'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*'
    )
    $found = @{}
    foreach ($path in $paths) {
        if (-not (Test-Path -LiteralPath $path)) { continue }
        foreach ($app in (Get-ItemProperty -Path $path -ErrorAction SilentlyContinue)) {
            $name = [string]$app.DisplayName
            if ([string]::IsNullOrWhiteSpace($name)) { continue }
            if (-not (Test-AnyPattern -Text $name -Patterns $OemPatterns)) { continue }
            if (Test-AnyPattern -Text $name -Patterns $ProtectedPatterns) { continue }
            $key = "$name|$($app.Publisher)"
            if (-not $found.ContainsKey($key)) {
                $found[$key] = [pscustomobject]@{ Name = $name; Publisher = [string]$app.Publisher }
            }
        }
    }
    return @($found.Values | Sort-Object Name)
}

function Show-Inventory {
    param([object[]] $Items)
    Write-Host "`nSuggested optional AppX packages (review; not a claim that they are unnecessary):" -ForegroundColor Yellow
    if (-not $Items -or $Items.Count -eq 0) {
        Write-Host 'No packages matched the current candidate patterns.'
    }
    else {
        $Items | Select-Object Id, Scope, Name, PackageId | Format-Table -Wrap -AutoSize
    }

    $win32 = @(Get-Win32ReviewInventory)
    Write-Host "`nLikely OEM/security Win32 apps (review-only; this script will not uninstall them):" -ForegroundColor Yellow
    if ($win32.Count -eq 0) {
        Write-Host 'No matches in the checked uninstall registry entries.'
    }
    else {
        $win32 | Format-Table Name, Publisher -Wrap -AutoSize
    }
}

function Remove-Candidate {
    param([Parameter(Mandatory)][object] $Item)
    if ($Item.Kind -eq 'Installed') {
        Remove-AppxPackage -Package $Item.PackageId -AllUsers -ErrorAction Stop
    }
    elseif ($Item.Kind -eq 'Provisioned') {
        Remove-AppxProvisionedPackage -Online -PackageName $Item.PackageId -ErrorAction Stop | Out-Null
    }
    else {
        throw "Unknown candidate kind '$($Item.Kind)'."
    }
}

function Invoke-SelectedRemoval {
    param([object[]] $Items, [switch] $All)
    if (-not $Items -or $Items.Count -eq 0) {
        Write-Host 'There are no AppX candidates to remove.'
        return
    }

    if ($All) {
        $selected = @($Items)
        Write-Host "`nALL $($selected.Count) listed AppX entries are selected. This includes all-user and future-profile scopes." -ForegroundColor Red
        $confirmation = Read-Host 'Type REMOVE ALL CANDIDATES exactly to authorize'
        if ($confirmation -cne 'REMOVE ALL CANDIDATES') {
            Write-Host 'Cancelled; nothing was removed.'
            return
        }
    }
    else {
        $raw = Read-Host 'Enter candidate ID(s), comma-separated; press Enter to cancel'
        if ([string]::IsNullOrWhiteSpace($raw)) { Write-Host 'Cancelled; nothing was removed.'; return }
        $requested = @()
        foreach ($part in ($raw -split ',')) {
            $number = 0
            if (-not [int]::TryParse($part.Trim(), [ref]$number)) {
                Write-Warning "Invalid ID '$($part.Trim())'; nothing was removed."
                return
            }
            $requested += $number
        }
        $uniqueIds = @($requested | Sort-Object -Unique)
        $selected = @($Items | Where-Object { $_.Id -in $uniqueIds } | Sort-Object Id)
        if ($selected.Count -ne $uniqueIds.Count) {
            Write-Warning 'One or more IDs are not in the displayed inventory; nothing was removed.'
            return
        }
        Write-Host "`nYou selected:" -ForegroundColor Yellow
        $selected | Select-Object Id, Scope, Name, PackageId | Format-Table -Wrap -AutoSize
        $confirmation = Read-Host 'Type YES exactly to authorize removal of only these entries'
        if ($confirmation -cne 'YES') { Write-Host 'Cancelled; nothing was removed.'; return }
    }

    foreach ($item in $selected) {
        try {
            Write-Host "Removing $($item.Name) [$($item.Scope)]..."
            Remove-Candidate -Item $item
            Write-Host 'Removal command completed.' -ForegroundColor Green
        }
        catch {
            Write-Warning "Removal failed for '$($item.Name)' ($($item.Scope)): $($_.Exception.Message)"
        }
    }
}

Write-Host 'Windows Optional App Inventory and Cleanup' -ForegroundColor Cyan
Write-Host 'Candidates are suggestions. Windows versions and user needs differ.'
Write-Host 'No package is removed until you select an action and type its confirmation.'

try {
    $items = @(Get-CandidateInventory)
}
catch {
    Write-Error $_
    exit 1
}
Show-Inventory -Items $items

while ($true) {
    Write-Host "`nActions: L=list, S=select IDs for removal, A=remove all candidates, R=refresh, Q=quit"
    $choice = (Read-Host 'Choice').Trim().ToUpperInvariant()
    switch ($choice) {
        'L' { Show-Inventory -Items $items }
        'S' { Invoke-SelectedRemoval -Items $items }
        'A' { Invoke-SelectedRemoval -Items $items -All }
        'R' {
            try {
                $items = @(Get-CandidateInventory)
                Show-Inventory -Items $items
            }
            catch { Write-Warning "Refresh failed: $($_.Exception.Message)" }
        }
        'Q' { break }
        default { Write-Host 'Choose L, S, A, R, or Q.' }
    }
    if ($choice -eq 'Q') { break }
}
Write-Host 'Finished.'
