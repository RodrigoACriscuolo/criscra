Automation Script to list all resources in an Azure subscription
What this script does:
   # - Connects to your Azure account
   # - Retrieves all resources in the subscription
   # - Retrieves VM properties for each resource
   # - Retreives VM status (running, stopped, deallocated, etc.)
   # - Displays a clean report with:
        * VM name, resource group, location, size, OS type, status, and tags
        * Size (SKU) of the VM
        * Admin username of the VM
        * Provisioning state
        * Power state
    ...
    
    Automation Script to list all resources in an Azure subscription

try {
    # Connect to Azure account
    Connect-AzAccount -errorAction Stop

    #Prompt for VM name and resource group (multiple Vms)
    Get-AzVM | ForEach-Object {
        $vm = $_
        $vmName = $vm.Name
        $resourceGroupName = $vm.ResourceGroupName

        # Get VM properties
        $vmProperties = Get-AzVM -ResourceGroupName $resourceGroupName -Name $vmName -ErrorAction Stop

        # Get VM status
        $vmStatus = (Get-AzVM -ResourceGroupName $resourceGroupName -Name $vmName -Status).Statuses | Where-Object { $_.Code -like 'PowerState/*' } | Select-Object -ExpandProperty DisplayStatus

        # Output Key VM Display report
        Write-Output "VM Name: $($vmProperties.Name)"
        Write-Output "Resource Group: $($vmProperties.ResourceGroupName)"
        Write-Output "Location: $($vmProperties.Location)"
        Write-Output "Size (SKU): $($vmProperties.HardwareProfile.VmSize)"
        Write-Output "OS Type: $($vmProperties.StorageProfile.OsDisk.OsType)"
        Write-Output "OS Disk Name: $($vmProperties.StorageProfile.OsDisk.Name)
        Write-Output "OS Disk Size (GB): $($vmProperties.StorageProfile.OsDisk.DiskSizeGB)"
        Write-Output "Admin Username: $($vmProperties.OsProfile.AdminUsername)"
        Write-Output "Provisioning State: $($vmProperties.ProvisioningState)"
        Write-Output "Power State: $($vmStatus)"
        Write-Output "Tags: $($vmProperties.Tags | ForEach-Object { "$($_.Key)=$($_.Value)" } | Out-String)"
        Write-Output "----------End of Report----------"
    } catch {
        Write-Host "Error: $($_.Exception.Message)" -ForegroundColor Red

}

