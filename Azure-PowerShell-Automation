Automation Script to list all resources in an Azure subscription

<#
.SYNOPSIS
    Azure inventory/report script:
      - VM report (detailed)
      - "List all Azure resources" report (manager-friendly)

.DESCRIPTION
    Connects to Azure using the Az PowerShell module and produces:
      - A VM inventory with status, size, OS, admin username, provisioning & power state, tags.
      - A compact list of all resources in the subscription (Name, Type, Resource Group, Location, SubscriptionId).
    Outputs to console and can export to CSV and/or JSON.

.NOTES
    Author: Rodrigo A. Criscuolo
    Revised: GitHub Copilot / Assistant
    MS. Date: 2026-10-12

.PREREQUISITES
    - Az PowerShell module (Install-Module -Name Az -Repository PSGallery -Force)
    - The account running the script must have Reader access on the subscription (or higher).
    - To retrieve VM power state, the account needs permission to read instance view for VM resources.

.EXAMPLE
    # VM report for entire subscription and export to CSV:
    .\azure-vm-and-resources-report.ps1 -ExportCsvPath .\vm-report.csv

    # VM report for a specific resource group and export to JSON:
    .\azure-vm-and-resources-report.ps1 -ResourceGroupName MyRG -ExportJsonPath .\vm-report.json

    # List all resources (manager view) and export to CSV:
    .\azure-vm-and-resources-report.ps1 -ListAllResources -ExportCsvPath .\all-resources.csv

.PARAMETER SubscriptionId
    Optional subscription id to run the report against. If omitted, the current context subscription is used.

.PARAMETER ResourceGroupName
    Optional: restrict VM report to a resource group.

.PARAMETER VMName
    Optional: restrict VM report to a single VM name.

.PARAMETER Tag
    Optional: filter VMs by tag. Accepts 'Key' or 'Key=Value'.

.PARAMETER ListAllResources
    Switch. When provided the script will also generate the manager-friendly "all resources" report.

.PARAMETER ExportCsvPath
    Optional path to export the resulting report (VM or AllResources as applicable) to CSV.

.PARAMETER ExportJsonPath
    Optional path to export the resulting report to JSON.

#>

[CmdletBinding()]
param(
    [string] $SubscriptionId,
    [string] $ResourceGroupName,
    [string] $VMName,
    [string] $Tag,
    [switch] $ListAllResources,
    [string] $ExportCsvPath,
    [string] $ExportJsonPath
)

function Write-Log {
    param([string]$Message, [string]$Level = 'INFO')
    $time = (Get-Date).ToString('s')
    Write-Output "[$time] [$Level] $Message"
}

function Parse-TagFilter {
    param([string] $TagString)
    if (-not $TagString) { return $null }
    if ($TagString -match '=') {
        $parts = $TagString.Split('=',2)
        return @{ Key = $parts[0].Trim(); Value = $parts[1].Trim(); HasValue = $true }
    } else {
        return @{ Key = $TagString.Trim(); Value = $null; HasValue = $false }
    }
}

function Get-SubscriptionIdFromResourceId {
    param([string] $resourceId)
    if (-not $resourceId) { return $null }
    $segments = $resourceId -split '/'
    # expected format: /subscriptions/{subId}/...
    if ($segments.Length -ge 3) { return $segments[2] }
    return $null
}

function Build-VmObject {
    param($vm)
    # safe accessors with fallback values
    $osType = if ($vm.StorageProfile -and $vm.StorageProfile.OsDisk) { $vm.StorageProfile.OsDisk.OsType } else { 'Unknown' }
    $osDiskName = if ($vm.StorageProfile -and $vm.StorageProfile.OsDisk -and $vm.StorageProfile.OsDisk.Name) { $vm.StorageProfile.OsDisk.Name } else { 'N/A' }
    $osDiskSizeGB = if ($vm.StorageProfile -and $vm.StorageProfile.OsDisk -and $vm.StorageProfile.OsDisk.DiskSizeGB) { $vm.StorageProfile.OsDisk.DiskSizeGB } else { $null }
    $adminUser = if ($vm.OSProfile -and $vm.OSProfile.AdminUsername) { $vm.OSProfile.AdminUsername } else { 'N/A' }
    $powerState = ($vm.Statuses | Where-Object { $_.Code -like 'PowerState/*' } | Select-Object -First 1).DisplayStatus
    if (-not $powerState) { $powerState = 'Unknown' }

    $tags = if ($vm.Tags -and $vm.Tags.Count -gt 0) {
        ($vm.Tags.GetEnumerator() | ForEach-Object { "$($_.Key)=$($_.Value)" }) -join '; '
    } else { 'None' }

    $subscriptionId = Get-SubscriptionIdFromResourceId -resourceId $vm.Id

    [PSCustomObject]@{
        SubscriptionId     = $subscriptionId
        VMName             = $vm.Name
        ResourceGroup      = $vm.ResourceGroupName
        Location           = $vm.Location
        Size               = if ($vm.HardwareProfile) { $vm.HardwareProfile.VmSize } else { 'Unknown' }
        OSType             = $osType
        OSDiskName         = $osDiskName
        OSDiskSizeGB       = $osDiskSizeGB
        AdminUsername      = $adminUser
        ProvisioningState  = if ($vm.ProvisioningState) { $vm.ProvisioningState } else { 'Unknown' }
        PowerState         = $powerState
        Tags               = $tags
        VMId               = $vm.Id
    }
}

function Get-VMReport {
    param(
        [string] $SubscriptionId,
        [string] $ResourceGroupName,
        [string] $VMName,
        [string] $TagFilter
    )

    # Build VM list efficiently. Use -Status to get power states in the same call.
    try {
        if ($ResourceGroupName -and $VMName) {
            $vms = Get-AzVM -ResourceGroupName $ResourceGroupName -Name $VMName -Status -ErrorAction Stop
            if ($null -eq $vms) { $vms = @() }
        }
        elseif ($ResourceGroupName) {
            $vms = Get-AzVM -ResourceGroupName $ResourceGroupName -Status -ErrorAction Stop
        }
        elseif ($VMName) {
            $vms = Get-AzVM -Name $VMName -Status -ErrorAction Stop
            if ($null -eq $vms) { $vms = @() }
        }
        else {
            $vms = Get-AzVM -Status -ErrorAction Stop
        }
    } catch {
        throw "Failed to get VMs: $($_.Exception.Message)"
    }

    # Normalize single-object to array
    if ($vms -and ($vms -isnot [System.Array])) {
        $vms = ,$vms
    }

    $tagSpec = Parse-TagFilter -TagString $TagFilter

    if ($tagSpec) {
        if ($tagSpec.HasValue) {
            $vms = $vms | Where-Object { $_.Tags -and $_.Tags.ContainsKey($tagSpec.Key) -and ($_.Tags[$tagSpec.Key] -eq $tagSpec.Value) }
        } else {
            $vms = $vms | Where-Object { $_.Tags -and $_.Tags.ContainsKey($tagSpec.Key) }
        }
    }

    $report = @()
    foreach ($vm in $vms) {
        try {
            $report += Build-VmObject -vm $vm
        } catch {
            Write-Log "Skipping VM '$($vm.Name)': $($_.Exception.Message)" 'WARN'
        }
    }

    return $report
}

function Get-AllResourcesReport {
    param([string] $SubscriptionId)

    try {
        $resources = Get-AzResource -ErrorAction Stop
    } catch {
        throw "Failed to get resources: $($_.Exception.Message)"
    }

    # Normalize and map to a compact manager-friendly object
    $report = $resources | ForEach-Object {
        $subId = Get-SubscriptionIdFromResourceId -resourceId $_.Id
        [PSCustomObject]@{
            SubscriptionId   = $subId
            Name             = $_.Name
            ResourceType     = $_.ResourceType
            ResourceGroup    = $_.ResourceGroupName
            Location         = if ($_.Location) { $_.Location } else { 'N/A' }
            ResourceId       = $_.Id
        }
    }

    return $report
}

# ---------- Main script ----------
try {
    Write-Log "Starting Azure inventory script."

    # Connect to Azure
    Write-Log "Connecting to Azure..."
    Connect-AzAccount -ErrorAction Stop

    if ($SubscriptionId) {
        Write-Log "Setting context to subscription $SubscriptionId"
        Set-AzContext -SubscriptionId $SubscriptionId -ErrorAction Stop
    } else {
        $currentContext = Get-AzContext
        Write-Log "Using current subscription: $($currentContext.Subscription.Id)"
    }

    # Generate VM report
    Write-Log "Collecting VM information..."
    $vmReport = Get-VMReport -SubscriptionId $SubscriptionId -ResourceGroupName $ResourceGroupName -VMName $VMName -TagFilter $Tag

    if ($vmReport.Count -eq 0) {
        Write-Log "No VMs found with the supplied filters." 'WARN'
    } else {
        # Output to console (table) and optionally export
        Write-Log "VM report collected: $($vmReport.Count) VMs."
        $vmReport | Sort-Object ResourceGroup, VMName | Format-Table -AutoSize

        if ($ExportCsvPath) {
            Write-Log "Exporting VM report to CSV: $ExportCsvPath"
            $vmReport | Sort-Object ResourceGroup, VMName | Export-Csv -Path $ExportCsvPath -NoTypeInformation -Force
        }
        if ($ExportJsonPath) {
            Write-Log "Exporting VM report to JSON: $ExportJsonPath"
            $vmReport | Sort-Object ResourceGroup, VMName | ConvertTo-Json -Depth 5 | Out-File -FilePath $ExportJsonPath -Encoding UTF8
        }
    }

    # Optionally generate all-resources manager view
    if ($ListAllResources) {
        Write-Log "Collecting all Azure resources (manager view)..."
        $allResources = Get-AllResourcesReport -SubscriptionId $SubscriptionId

        if ($allResources.Count -eq 0) {
            Write-Log "No resources found in the subscription." 'WARN'
        } else {
            # Manager-friendly summary table
            Write-Log "All-resources report collected: $($allResources.Count) resources."
            $allResources | Select-Object SubscriptionId, Name, ResourceType, ResourceGroup, Location | Sort-Object ResourceGroup, Name | Format-Table -AutoSize

            if ($ExportCsvPath -and -not $vmReport) {
                # If user passed only a single ExportCsvPath and asked for both, append suffix
                $csvPath = $ExportCsvPath
                $base = [IO.Path]::GetFileNameWithoutExtension($csvPath)
                $dir = [IO.Path]::GetDirectoryName($csvPath)
                if (-not $dir) { $dir = '.' }
                $resCsv = Join-Path $dir ($base + '-all-resources.csv')
                Write-Log "Exporting All Resources report to CSV: $resCsv"
                $allResources | Sort-Object ResourceGroup, Name | Export-Csv -Path $resCsv -NoTypeInformation -Force
            } elseif ($ExportCsvPath) {
                # If CSV path was provided already for VM, export a second file for resources
                $csvPath = $ExportCsvPath
                $base = [IO.Path]::GetFileNameWithoutExtension($csvPath)
                $dir = [IO.Path]::GetDirectoryName($csvPath)
                if (-not $dir) { $dir = '.' }
                $resCsv = Join-Path $dir ($base + '-all-resources.csv')
                Write-Log "Exporting All Resources report to CSV: $resCsv"
                $allResources | Sort-Object ResourceGroup, Name | Export-Csv -Path $resCsv -NoTypeInformation -Force
            }

            if ($ExportJsonPath) {
                $jsonPath = $ExportJsonPath
                $base = [IO.Path]::GetFileNameWithoutExtension($jsonPath)
                $dir = [IO.Path]::GetDirectoryName($jsonPath)
                if (-not $dir) { $dir = '.' }
                $resJson = Join-Path $dir ($base + '-all-resources.json')
                Write-Log "Exporting All Resources report to JSON: $resJson"
                $allResources | ConvertTo-Json -Depth 5 | Out-File -FilePath $resJson -Encoding UTF8
            }
        }
    }

    Write-Log "Script completed successfully."
} catch {
    Write-Log "Fatal error: $($_.Exception.Message)" 'ERROR'
    Exit 1
}

